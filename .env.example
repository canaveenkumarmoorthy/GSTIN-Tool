# CA Tax & GST Automation Suite - Environment Configuration

# Server Binding (Loopback default for local practice desktop security)
PORT=3000
HOST=127.0.0.1

# Operational Execution Mode:
# DEMO: Generates synthetic test files, runs mock portal workflows with [SIMULATED] tags.
# REAL: Calls 1_downloader.js & 2_summary_preparer.js. Fails visibly if scripts or credentials are missing.
EXECUTION_MODE=DEMO

# Vault Cryptographic Keys (AES-256-GCM + PBKDF2)
# NEVER commit the actual production vault passphrase to version control!
VAULT_MASTER_KEY=practice_offline_vault_secret_change_in_production_2026
VAULT_SALT=c8f92a10b47e382d6190ef01

# Storage Directory (all client data, inputs, downloads, and outputs are sandboxed here)
DATA_DIR=./data

# Playwright Configuration (Optional for REAL mode)
# PLAYWRIGHT_HEADLESS=false
